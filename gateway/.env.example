BETA_ACCESS_TOKENS=["example-token-a","example-token-b"]
GATEWAY_UPSTREAM_PROVIDER=gemini
GEMINI_API_KEY=example-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
DEEPSEEK_API_KEY=example-deepseek-api-key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
PORT=8000
